--border-hover: #ffd95a;
--text-primary: #ffffe0;
--text-secondary: #ffe0a0;
--accent-primary: #ffd93a;
--accent-secondary: #ffe67a;
--accent-tertiary: #b89f2a;
--shadow-color: rgba(240, 200, 30, 0.3);
}

body.theme-pink {
--bg-primary: #1a0a15;
--bg-secondary: #2a1222;
--bg-tertiary: #3a1a2f;
--bg-card: #2a1222;
--bg-hover: #4a243a;
--border-color: #b83a8f;
--border-hover: #ff3b9f;
--text-primary: #ffe0f5;
--text-secondary: #ffa0d0;
--accent-primary: #ff3b9f;
--accent-secondary: #ff7ac0;
--accent-tertiary: #b82a7a;
--shadow-color: rgba(255, 30, 150, 0.3);
}
body.theme-lime {
--bg-primary: #0f1a0a;
--bg-secondary: #1a2a12;
--bg-tertiary: #253a1a;
--bg-card: #1a2a12;
--bg-hover: #354a24;
--border-color: #8fb83a;
--border-hover: #b3ff3b;
--text-primary: #f0ffe0;
--text-secondary: #d0ffa0;
--accent-primary: #b3ff3b;
--accent-secondary: #d0ff7a;
--accent-tertiary: #8fb82a;
--shadow-color: rgba(150, 255, 30, 0.3);
}
body.theme-white {
--bg-primary: #1a1a1a;
--bg-secondary: #2a2a2a;
--bg-tertiary: #3a3a3a;
--bg-card: #2a2a2a;
--bg-hover: #4a4a4a;
--border-color: #b0b0b0;
--border-hover: #ffffff;
--text-primary: #ffffff;
--text-secondary: #e0e0e0;
--accent-primary: #ffffff;
--accent-secondary: #f0f0f0;
--accent-tertiary: #c0c0c0;
--shadow-color: rgba(255, 255, 255, 0.2);
}
body.theme-black {
--bg-primary: #000000;
--bg-secondary: #080808;
--bg-tertiary: #101010;
--bg-card: #080808;
--bg-hover: #202020;
--border-color: #404040;
--border-hover: #808080;
--text-primary: #e0e0e0;
--text-secondary: #a0a0a0;
--accent-primary: #808080;
--accent-secondary: #a0a0a0;
--accent-tertiary: #404040;
--shadow-color: rgba(255, 255, 255, 0.1);
}
body {
font-family: "Inter", system-ui, sans-serif;
background: var(--bg-primary);
min-height: 100vh;
color: var(--text-primary);
line-height: 1.5;
display: flex;
transition: background-color 0.5s ease;
}
/* Apply transitions to all themed elements */
.side-nav,
.disclaimer-card,
.letter-btn,
.search-box input,
.game-card,
.pin-btn,
.top-section,
.discord-link,
.browser-toggle-btn,
.theme-picker-btn,
.theme-dropdown,
.browser-container,
.tab-bar,
.tab,
.nav-bar,
.nav-btn,
.url-bar-container,
.bookmarks-bar,
.bookmark-item,
.menu-dropdown,
.menu-item,
.submenu,
.browser .content {
transition: background-color 0.5s ease, border-color 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;
}
/* Sidebar visibility states */
.side-nav {
width: 240px;
background: var(--bg-secondary);
border-right: 1px solid var(--border-color);
height: 100vh;
position: sticky;
top: 0;
display: flex;
flex-direction: column;
padding: 24px 16px;
gap: 20px;
z-index: 50;
transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.5s ease;
}
.side-nav.hidden {
transform: translateX(-100%);
opacity: 0;
pointer-events: none;
}
/* Main content adjusts when sidebar is hidden */
.main-content {
flex: 1;
padding: 24px 28px;
max-width: 1400px;
margin: 0 auto;
width: 100%;
transition: opacity 0.3s ease;
}
.main-content.full-width {
max-width: none;
margin-left: 0;
}
.main-content.hidden {
display: none;
}
/* Disclaimer overlay */
.disclaimer-overlay {
position: fixed;
inset: 0;
width: 100%;
height: 100%;
background: rgba(0, 0, 0, 0.7);
backdrop-filter: blur(90px) brightness(0.3);
-webkit-backdrop-filter: blur(90px) brightness(0.3);
display: flex;
align-items: center;
justify-content: center;
z-index: 10000;
transition: opacity 0.3s ease;
}
.disclaimer-overlay.hidden {
opacity: 0;
pointer-events: none;
}
.disclaimer-card {
background: var(--bg-secondary);
border: 2px solid var(--accent-tertiary);
border-radius: 16px;
padding: 32px;
max-width: 500px;
width: 90%;
position: relative;
box-shadow: 0 20px 40px var(--shadow-color);
}
.disclaimer-close {
position: absolute;
top: 16px;
right: 20px;
background: none;
border: none;
color: var(--accent-secondary);
font-size: 28px;
cursor: pointer;
padding: 0;
width: 32px;
height: 32px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 4px;
transition: 0.2s;
}
.disclaimer-close:hover {
background: var(--bg-hover);
color: var(--accent-primary);
}
.disclaimer-title {
font-size: 1.8rem;
font-weight: 700;
color: var(--accent-primary);
margin-bottom: 20px;
padding-right: 30px;
}
.disclaimer-text {
color: var(--text-secondary);
margin-bottom: 28px;
line-height: 1.6;
font-size: 1.1rem;
}
.disclaimer-text a {
color: var(--accent-primary);
}
.disclaimer-links {
display: flex;
gap: 20px;
flex-wrap: wrap;
}
.disclaimer-link {
background: var(--bg-hover);
color: var(--accent-secondary);
text-decoration: none;
padding: 12px 24px;
border-radius: 8px;
border: 1px solid var(--accent-tertiary);
font-weight: 600;
transition: 0.2s;
display: inline-flex;
align-items: center;
gap: 8px;
}
.disclaimer-link:hover {
background: var(--accent-tertiary);
color: var(--text-primary);
border-color: var(--accent-primary);
}
.nav-header h2 {
font-weight: 600;
font-size: 1.1rem;
letter-spacing: -0.2px;
color: var(--accent-secondary);
margin-bottom: 4px;
}
.nav-header h2 a {
color: var(--accent-secondary);
text-decoration: none;
}
.nav-header h2 a:hover {
color: var(--accent-primary);
text-decoration: underline;
}
/* Letter navigation grid */
.letter-nav {
display: flex;
flex-wrap: wrap;
gap: 4px;
justify-content: center;
max-height: 350px;
overflow-y: auto;
padding: 8px 0;
scrollbar-width: thin;
scrollbar-color: var(--border-hover) var(--bg-secondary);
border-top: 1px solid var(--border-color);
border-bottom: 1px solid var(--border-color);
}
.letter-nav::-webkit-scrollbar {
width: 4px;
}
.letter-nav::-webkit-scrollbar-track {
background: var(--bg-secondary);
}
.letter-nav::-webkit-scrollbar-thumb {
background: var(--accent-tertiary);
border-radius: 4px;
}
.letter-btn {
width: 32px;
height: 32px;
display: flex;
align-items: center;
justify-content: center;
background: transparent;
border: none;
font-weight: 500;
font-size: 0.85rem;
color: var(--text-secondary);
cursor: pointer;
transition: 0.15s;
text-transform: uppercase;
border-radius: 4px;
}
.letter-btn:hover {
background: var(--bg-hover);
color: var(--text-primary);
}
.letter-btn.empty-letter {
opacity: 0.2;
pointer-events: none;
}
/* Search box at bottom */
.search-box {
position: relative;
width: 100%;
margin-top: auto;
}
.search-box i {
position: absolute;
left: 12px;
top: 50%;
transform: translateY(-50%);
color: var(--text-secondary);
font-size: 0.85rem;
pointer-events: none;
}
.search-box input {
width: 100%;
background: var(--bg-card);
border: 1px solid var(--border-color);
border-radius: 6px;
padding: 10px 12px 10px 36px;
color: var(--text-primary);
font-size: 0.9rem;
outline: none;
transition: 0.2s;
}
.search-box input:focus {
border-color: var(--accent-primary);
background: var(--bg-hover);
}
.search-box input::placeholder {
color: var(--text-secondary);
font-weight: 300;
}
.sidebar-footer {
font-size: 0.75rem;
color: var(--text-secondary);
text-align: center;
}
.sidebar-footer a {
color: var(--accent-secondary);
text-decoration: none;
}
.sidebar-footer a:hover {
color: var(--accent-primary);
}
.main-header {
margin-bottom: 28px;
display: flex;
align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 12px;
}
.main-header h1 {
font-size: 1.8rem;
font-weight: 700;
color: var(--text-primary);
letter-spacing: -0.02em;
}
.main-header h1 a {
color: var(--accent-secondary);
text-decoration: none;
border-bottom: 2px dotted var(--accent-tertiary);
}
.main-header h1 a:hover {
color: var(--accent-primary);
}
.header-controls {
display: flex;
gap: 12px;
align-items: center;
}
/* Theme picker button and dropdown */
.theme-picker {
position: relative;
}
.theme-picker-btn {
background: var(--bg-tertiary);
border: 1px solid var(--border-color);
color: var(--accent-secondary);
padding: 8px 16px;
border-radius: 6px;
font-size: 0.9rem;
cursor: pointer;
transition: 0.2s;
display: flex;
align-items: center;
gap: 8px;
}
.theme-picker-btn:hover {
background: var(--bg-hover);
border-color: var(--accent-tertiary);
color: var(--accent-primary);
}
.theme-picker-btn i {
font-size: 1rem;
}
.theme-dropdown {
position: absolute;
top: 45px;
right: 0;
background: var(--bg-tertiary);
border: 1px solid var(--border-color);
border-radius: 8px;
box-shadow: 0 4px 20px var(--shadow-color);
width: 200px;
padding: 8px 0;
z-index: 1000;
display: none;
}
.theme-dropdown.show {
display: block;
}
.theme-option {
padding: 10px 16px;
font-size: 14px;
color: var(--text-primary);
cursor: pointer;
display: flex;
align-items: center;
gap: 12px;
transition: 0.2s;
}
.theme-option:hover {
background: var(--bg-hover);
color: var(--accent-primary);
}
.theme-option i {
width: 20px;
color: var(--accent-secondary);
}
.theme-option:hover i {
color: var(--accent-primary);
}
.theme-option.active {
background: var(--accent-tertiary);
color: var(--text-primary);
}
.theme-option.active i {
color: var(--text-primary);
}
.browser-toggle-btn {
background: var(--bg-tertiary);
border: 1px solid var(--border-color);
color: var(--accent-secondary);
padding: 8px 16px;
border-radius: 6px;
font-size: 0.9rem;
cursor: pointer;
transition: 0.2s;
display: flex;
align-items: center;
gap: 8px;
}
.browser-toggle-btn:hover {
background: var(--bg-hover);
border-color: var(--accent-tertiary);
color: var(--accent-primary);
}
.browser-toggle-btn i {
font-size: 1rem;
}
.discord-link {
background: var(--bg-tertiary);
padding: 8px 16px;
border-radius: 6px;
border: 1px solid var(--border-color);
font-size: 0.9rem;
}
.discord-link a {
color: var(--accent-secondary);
text-decoration: none;
}
.discord-link a:hover {
color: var(--accent-primary);
}
.letter-section {
margin-bottom: 28px;
background: var(--bg-tertiary);
border-radius: 8px;
padding: 20px 22px;
border: 1px solid var(--border-color);
}
.letter-section.hidden-section {
display: none;
}
.letter-header {
font-size: 1.5rem;
font-weight: 600;
margin-bottom: 16px;
padding-bottom: 8px;
border-bottom: 1px solid var(--border-color);
color: var(--text-primary);
display: flex;
align-items: center;
gap: 12px;
}
.letter-header span {
background: var(--bg-hover);
border-radius: 4px;
font-size: 0.8rem;
padding: 2px 8px;
color: var(--accent-secondary);
font-weight: 500;
}
.games-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
gap: 6px;
will-change: transform;
}
.game-card {
background: var(--bg-card);
border: 1px solid var(--border-color);
border-radius: 6px;
padding: 10px 10px;
transition: all 0.2s ease;
cursor: pointer;
display: flex;
align-items: center;
gap: 8px;
color: var(--text-primary);
font-weight: 400;
font-size: 0.85rem;
user-select: none;
position: relative;
transform: translateZ(0);
backface-visibility: hidden;
}
.game-card:hover {
background: var(--bg-hover);
border-color: var(--border-hover);
}
.game-card i {
font-size: 1rem;
color: var(--text-secondary);
width: 18px;
text-align: center;
}
.game-card .game-name {
flex: 1;
word-break: break-word;
line-height: 1.3;
}
.pin-btn {
position: absolute;
right: 6px;
top: 50%;
transform: translateY(-50%);
background: var(--bg-hover);
border: 1px solid var(--accent-tertiary);
color: var(--accent-secondary);
font-size: 0.8rem;
width: 24px;
height: 24px;
border-radius: 4px;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
opacity: 0;
transition: opacity 0.2s, background 0.2s;
}
.game-card:hover .pin-btn {
opacity: 1;
}
.pin-btn:hover {
background: var(--accent-tertiary);
color: var(--text-primary);
}
.top-section {
margin-bottom: 28px;
background: var(--bg-tertiary);
border-radius: 8px;
padding: 20px 22px;
border: 1px solid var(--border-color);
}
.top-header {
display: flex;
align-items: center;
gap: 12px;
margin-bottom: 16px;
font-size: 1.3rem;
font-weight: 600;
color: var(--text-primary);
border-bottom: 1px solid var(--border-color);
padding-bottom: 8px;
}
.top-header i {
color: var(--text-secondary);
}
.recent-header-controls {
margin-left: auto;
display: flex;
gap: 8px;
}
.clear-recent-btn {
background: var(--bg-hover);
border: 1px solid var(--accent-tertiary);
color: var(--accent-secondary);
padding: 4px 12px;
border-radius: 4px;
font-size: 0.8rem;
cursor: pointer;
transition: 0.2s;
}
.clear-recent-btn:hover {
background: var(--accent-tertiary);
color: var(--text-primary);
}
.recent-expand-btn {
background: var(--bg-card);
border: 1px solid var(--border-color);
color: var(--accent-secondary);
padding: 4px 12px;
border-radius: 4px;
font-size: 0.8rem;
cursor: pointer;
margin-top: 12px;
display: inline-block;
transition: 0.2s;
}
.recent-expand-btn:hover {
background: var(--bg-hover);
color: var(--accent-primary);
}
.pinned-section .game-card {
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
padding: 12px 8px;
}
.pinned-section .game-name {
margin-bottom: 10px;
font-weight: 500;
font-size: 0.8rem;
width: 100%;
}
.pinned-controls {
display: flex;
gap: 6px;
justify-content: center;
width: 100%;
}
.pinned-controls button {
background: var(--bg-card);
border: 1px solid var(--border-color);
color: var(--accent-secondary);
border-radius: 4px;
width: 28px;
height: 28px;
cursor: pointer;
font-size: 0.75rem;
display: flex;
align-items: center;
justify-content: center;
transition: 0.2s;
}
.pinned-controls button:hover {
background: var(--accent-tertiary);
color: var(--text-primary);
border-color: var(--accent-primary);
}
.delete-recent-btn {
background: var(--bg-card);
border: 1px solid var(--accent-tertiary);
color: var(--accent-primary);
border-radius: 4px;
width: 28px;
height: 28px;
cursor: pointer;
font-size: 0.75rem;
display: flex;
align-items: center;
justify-content: center;
transition: 0.2s;
margin-left: auto;
opacity: 0;
}
.game-card:hover .delete-recent-btn {
opacity: 1;
}
.delete-recent-btn:hover {
background: var(--accent-tertiary);
color: var(--text-primary);
}
.no-games-message {
color: var(--text-secondary);
font-style: italic;
padding: 24px;
text-align: center;
background: var(--bg-card);
border-radius: 6px;
border: 1px solid var(--border-color);
font-size: 0.9rem;
}
.search-results-count {
color: var(--accent-secondary);
font-size: 0.9rem;
margin-left: 12px;
font-weight: normal;
}
/* Browser container - full screen when active */
.browser-container {
display: none;
position: fixed;
top: 0;
left: 0;
right: 0;
bottom: 0;
background: var(--bg-primary);
z-index: 1000;
flex-direction: column;
border: none;
}
.browser-container.active {
display: flex;
}
.browser {
width: 100%;
height: 100%;
background: var(--bg-primary);
display: flex;
flex-direction: column;
}
.tab-bar {
background: var(--bg-secondary);
display: flex;
align-items: center;
padding: 8px 8px 0 8px;
gap: 4px;
border-bottom: 1px solid var(--border-color);
flex-shrink: 0;
}
.tabs {
display: flex;
flex: 1;
gap: 4px;
overflow-x: auto;
scrollbar-width: thin;
padding-bottom: 2px;
}
.tabs::-webkit-scrollbar {
height: 4px;
}
.tabs::-webkit-scrollbar-track {
background: var(--bg-secondary);
}
.tabs::-webkit-scrollbar-thumb {
background: var(--accent-tertiary);
border-radius: 4px;
}

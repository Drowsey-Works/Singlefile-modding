UGS - modified by Drowsey
* {
margin: 0;
padding: 0;
box-sizing: border-box;
}
:root {
--bg-primary: #0f0a0a;
--bg-secondary: #140c0c;
--bg-tertiary: #1a1210;
--bg-card: #120a0a;
--bg-hover: #2a1a16;
--border-color: #3a2420;
--border-hover: #b84a3a;
--text-primary: #f0e0e0;
--text-secondary: #b28a7a;
--accent-primary: #ff7a5a;
--accent-secondary: #ffaa8a;
--accent-tertiary: #b84a3a;
--shadow-color: rgba(180, 60, 30, 0.3);
/* Transition for smooth theme changes */
transition: background-color 0.5s ease, border-color 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;
}
/* Individual theme styles */
body.theme-red {
--bg-primary: #1a0a0a;
--bg-secondary: #2a1210;
--bg-tertiary: #3a1a18;
--bg-card: #2a1210;
--bg-hover: #4a2a24;
--border-color: #b84a3a;
--border-hover: #ff7a5a;
--text-primary: #ffe0e0;
--text-secondary: #ffb0a0;
--accent-primary: #ff4a3a;
--accent-secondary: #ff8a7a;
--accent-tertiary: #b83a2a;
--shadow-color: rgba(255, 60, 30, 0.3);
}
body.theme-orange {

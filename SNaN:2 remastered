--border-hover: #ff9a5a;
--text-primary: #fff0e0;
--text-secondary: #ffc0a0;
--accent-primary: #ff8a3a;
--accent-secondary: #ffb07a;
--accent-tertiary: #b85a2a;
--shadow-color: rgba(255, 120, 30, 0.3);
